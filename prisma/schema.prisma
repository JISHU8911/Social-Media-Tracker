datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // "SUPER_ADMIN" or "ADMIN"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Designation {
  id              String       @id @default(uuid())
  designationName String       @unique
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  submissions     Submission[]
}

model Post {
  id           String       @id @default(uuid())
  title        String
  imageUrl     String
  caption      String?      // Multiline text up to 5000 chars
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  xUrl         String?
  trackingCode String       @unique
  createdBy    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
}

model Submission {
  id               String      @id @default(uuid())
  postId           String
  post             Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  fullName         String
  designationId    String
  designation      Designation @relation(fields: [designationId], references: [id])
  facebookActions  String?     // Stored as JSON string array e.g. ["Like", "Comment"]
  instagramActions String?     // Stored as JSON string array
  linkedinActions  String?     // Stored as JSON string array
  xActions         String?     // Stored as JSON string array
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([postId, fullName, designationId], name: "unique_employee_post_submission")
}
